[Unit]
Description=Aritioz FastAPI AI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aritioz
Group=aritioz
WorkingDirectory=/opt/aritioz
EnvironmentFile=/opt/aritioz/.env
ExecStart=/opt/aritioz/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/opt/aritioz

[Install]
WantedBy=multi-user.target
