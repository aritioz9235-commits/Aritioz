# Standalone backend configuration.
# Never expose SUPABASE_SERVICE_ROLE_KEY or provider API keys to the frontend.

APP_ENV=production
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=https://YOUR_DOMAIN
WORKSPACE_ROOT=

DATABASE_URL=
CONTENT_DATA_SOURCE=database
DB_ENV=production
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Required for Aritioz's own email/password signup and login. Generate with:
# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Development-only local workspace editor. Generate a distinct random value;
# never configure this in production.
WORKSPACE_ACCESS_TOKEN=

AI_DEFAULT_PROVIDER=glm
AI_PROVIDER_ORDER=glm,qwen,deepseek,ollama
GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=60
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
SUPABASE_STORAGE_BUCKET=aritioz-files
MAX_UPLOAD_BYTES=52428800
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

REQUEST_TIMEOUT_SECONDS=60
MAX_INPUT_CHARS=30000
MAX_REQUEST_BYTES=8388608
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
