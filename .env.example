DATABASE_URL=your_database_url
CONTENT_DATA_SOURCE=database
DB_ENV=staging
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
JWT_SECRET=generate_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Required only for the local development workspace editor. Keep this local.
NEXT_PUBLIC_WORKSPACE_ACCESS_TOKEN=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
MAX_UPLOAD_BYTES=52428800
SUPABASE_STORAGE_BUCKET=aritioz-files

APP_ENV=production
PORT=8000
ALLOWED_ORIGINS=https://www.aritioz.com

# Provider routing
AI_DEFAULT_PROVIDER=glm
AI_PROVIDER_ORDER=glm,qwen,deepseek,ollama

# Hosted model-router lanes (OpenAI-compatible APIs)
GLM_API_KEY=your_glm_key_here
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
QWEN_API_KEY=your_qwen_key_here
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

#Gemini (both values are required to enable it)
GEMINI_API_KEY=your_real_key_here
GEMINI_MODEL=your_model_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# NVIDIA/Nemotron (all values are required to enable it)
NVIDIA_API_KEY=your_real_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_model_here

# Optional local Ollama fallback
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=your_model_here

# NVIDIA/Nemotron (all values are required to enable it)
NVIDIA_API_KEY=your_real_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_model_here

# Optional local Ollama fallback
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=your_model_here

# ImageKit private key must remain server-side.
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_ID=your_imagekit_id
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Safeguards
REQUEST_TIMEOUT_SECONDS=60
MAX_INPUT_CHARS=30000
MAX_REQUEST_BYTES=8388608
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
